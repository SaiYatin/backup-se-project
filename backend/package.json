{
  "name": "fundraising-portal-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Backend API for Fundraising Portal System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:unit": "cross-env NODE_ENV=test jest src/tests/unit --detectOpenHandles --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest src/tests/integration --detectOpenHandles --forceExit",
    "test:no-coverage": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "fundraising",
    "donations",
    "api",
    "express"
  ],
  "author": "Fundraising Portal Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "require": "^2.4.20",
    "sequelize": "^6.35.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
